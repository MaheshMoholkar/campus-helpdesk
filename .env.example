# Copy to .env. Values in .env override .env.lab (written by `lab up`).

# --- database (default: the docker-compose Postgres) ---
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5433/helpdesk

# --- models ---
# "ollama" talks to OLLAMA_BASE_URL; "fake" uses deterministic stand-ins (tests, offline work).
AI_BACKEND=ollama
OLLAMA_BASE_URL=https://ollama.lab.maheshmoholkar.in/v1
LLM_MODEL=qwen3.5:4b
EMBED_MODEL=bge-m3

# --- retrieval ---
RETRIEVAL_MODE=hybrid        # vector | hybrid
RERANKER=none                # none | http | fake
RERANK_URL=                  # e.g. http://mini:8085/rerank when RERANKER=http
ABSTAIN_THRESHOLD=0.0        # set from the first baseline run

# --- auth between the two services ---
STUDENT_API_URL=http://localhost:8001
JWT_ISSUER=campus-student-api
JWT_AUDIENCE=campus-helpdesk

# --- chat API ---
INGEST_API_KEY=change-me
CORS_ORIGINS=["http://localhost:5173"]

# --- tracing (docker compose --profile tracing up -d) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
